{
  "name": "@rag/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "node --conditions=react-server --env-file=../../.env tools/prompt-eval.mjs",
    "scores": "node --conditions=react-server --env-file=../../.env tools/score-probe.mjs",
    "isolation": "node --conditions=react-server --env-file=../../.env tools/isolation.mjs",
    "prompt-snapshot": "node --conditions=react-server --env-file=../../.env tools/prompt-snapshot.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@rag/bookings": "workspace:*",
    "@rag/chunker": "workspace:*",
    "@rag/db": "workspace:*",
    "@rag/openai": "workspace:*"
  },
  "devDependencies": {
    "@rag/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
