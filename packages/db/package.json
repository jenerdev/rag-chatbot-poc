{
  "name": "@rag/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sql/*": "./sql/*"
  },
  "files": [
    "dist",
    "sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node --conditions=react-server --env-file=../../.env tools/verify.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@rag/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
