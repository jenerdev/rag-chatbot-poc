# Copy to .env and fill in. .env is gitignored — never commit it.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase dashboard -> Project Settings -> API
# Use the service_role key, NOT the anon key (D-006). It never reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the per-tenant admin session cookie (tenancy Phase 6). At least 32
# characters of randomness. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs every admin out. It is not an admin key.
ADMIN_COOKIE_SECRET=

PORT=3000
