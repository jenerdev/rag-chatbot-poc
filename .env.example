# Copy to .env and fill in. .env is gitignored — never commit it.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase dashboard -> Project Settings -> API
# Use the service_role key, NOT the anon key (D-006). It never reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Every request uses the publishable key plus a server-minted tenant token
# (auth-rls Phase 3). The key is safe in a browser; the token is not sent to one.
SUPABASE_PUBLISHABLE_KEY=
# Our own EC P-256 private key, as ONE line of JWK JSON with a kid, imported in
# the dashboard as a STANDBY JWT signing key (D-039). SERVER-ONLY: it can mint
# any claim. Never commit it.
TENANT_SIGNING_JWK=

# Signs the per-tenant admin session cookie (tenancy Phase 6). At least 32
# characters of randomness. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs every admin out. It is not an admin key.
ADMIN_COOKIE_SECRET=

PORT=3000
